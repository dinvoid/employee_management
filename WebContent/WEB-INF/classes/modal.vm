<div id="employeeModal" class="modal-overlay" style="display:none;">

    <div class="modal-content">

        <button type="button" class="modal-close" onclick="closeModal()">
            &times;
        </button>

        <h3>Premium Schedule</h3>

        <table class="modal-table">
            <thead>
                <tr>
                    <th>Policy Year</th>
                    <th>Premiums</th>
                </tr>
            </thead>

            <tbody id="premiumScheduleBody">

                #foreach($emp in $empList2)

                <tr>
                    <td>$!emp.id</td>
                    <td>$!emp.name</td>
                </tr>

                #end

            </tbody>
        </table>

    </div>

</div>

